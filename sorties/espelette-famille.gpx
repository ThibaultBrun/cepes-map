<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="cepes.tbrun.dev" xmlns="http://www.topografix.com/GPX/1/1">
 <metadata><name>Chasse aux cepes - Chenaie Espelette/Souraide (famille)</name><desc>Boucle 2,5km (D+ 145m), chenaie. Enfants + grands-parents (vallonne).</desc></metadata>
 <wpt lat="43.324841" lon="-1.500566"><name>🚗 Camp de base</name><desc>Parking en lisière de la chênaie (secteur Souraïde/Espelette).</desc><sym>Flag</sym></wpt>
 <wpt lat="43.326233" lon="-1.506218"><name>🌳 Porte de la forêt</name><desc>On entre dans les bois de chênes. Les yeux au sol !</desc><sym>Flag</sym></wpt>
 <wpt lat="43.324666" lon="-1.511122"><name>👑 Le Roi Chêne</name><desc>Le plus gros chêne : les cèpes poussent à ses pieds. Compte les glands !</desc><sym>Flag</sym></wpt>
 <wpt lat="43.324747" lon="-1.512383"><name>🌶️ Pause piment</name><desc>Pause goûter — ici on est au pays du piment d'Espelette !</desc><sym>Flag</sym></wpt>
 <wpt lat="43.326694" lon="-1.508168"><name>🐗 Coin du sanglier</name><desc>Terre retournée = sanglier gourmand de glands. Qui voit le 1er champi ?</desc><sym>Flag</sym></wpt>
 <wpt lat="43.324987" lon="-1.503816"><name>🧚 Sentier frais</name><desc>Mousse + fougères = sol humide, dernier coup d'œil.</desc><sym>Flag</sym></wpt>

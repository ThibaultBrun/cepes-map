<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="cepes.tbrun.dev" xmlns="http://www.topografix.com/GPX/1/1">
 <metadata><name>Chasse aux cepes - Grande foret d'Ustaritz (famille)</name><desc>Boucle 2,5km (D+ 72m), depart parking. Chenaie 378ha. Enfants 5 et 9 + grands-parents.</desc></metadata>
 <wpt lat="43.387033" lon="-1.494881"><name>Camp de base</name><desc>Parking - depart & arrivee, en lisiere de la grande foret. 🚗</desc><sym>Flag</sym></wpt>
 <wpt lat="43.384955" lon="-1.499307"><name>Porte de la foret</name><desc>On entre dans le royaume des chenes. Ouvrez l'oeil au sol ! 🌳</desc><sym>Flag</sym></wpt>
 <wpt lat="43.383152" lon="-1.503204"><name>Le Roi Chene</name><desc>Trouve le plus gros chene : les cepes poussent a ses pieds. Compte les glands ! 👑</desc><sym>Flag</sym></wpt>
 <wpt lat="43.382031" lon="-1.504226"><name>Clairiere du gouter</name><desc>Pause gouter ! Lumiere = lisiere = coin a cepes. 🍪🍄</desc><sym>Flag</sym></wpt>
 <wpt lat="43.384062" lon="-1.502773"><name>Virage du sanglier</name><desc>Terre retournee = un sanglier a cherche des glands. Qui voit le 1er champi ? 🐗🔭</desc><sym>Flag</sym></wpt>
 <wpt lat="43.386270" lon="-1.498288"><name>Sentier des fees</name><desc>Mousse + fougeres = sol frais. Dernier coup d'oeil avant le retour. 🧚</desc><sym>Flag</sym></wpt>
